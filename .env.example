# 复制为 .env 后填写；.env 不提交到 Git

# ---- 基础 ----
FACTOPIA_DATA_DIR=/workspace/runtime/data
FACTOPIA_QLIB_DIR=/workspace/runtime/qlib_data
MLFLOW_TRACKING_URI=http://mlflow:5000

# ---- LLM（RD-Agent 使用）----
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
# 对话模型：DeepSeek
# 方式一：阿里云百炼（OpenAI 兼容，当前使用）
CHAT_MODEL=openai/deepseek-v4.1-flash
OPENAI_API_KEY=
OPENAI_API_BASE=https://<你的百炼工作空间>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
FACTOPIA_LLM_BASE_URL=https://<你的百炼工作空间>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
FACTOPIA_LLM_MODEL=deepseek-v4.1-flash
FACTOPIA_LLM_API_KEY=
FACTOPIA_LLM_EXTRA_BODY={"enable_thinking": false}
# 方式二：DeepSeek 官方（取消注释，并删除方式一）
#CHAT_MODEL=deepseek/deepseek-chat
#DEEPSEEK_API_KEY=
# 费用：单价（美元 / 百万 token，按服务商价目表填写）；RD-Agent 统计不到思考 token，输出按系数放大估算
FACTOPIA_LLM_PRICE_IN=0.27
FACTOPIA_LLM_PRICE_OUT=1.10
FACTOPIA_LLM_REASONING_FACTOR=3
# 公告标注每次运行的花费上限（美元）
FACTOPIA_TEXT_BUDGET_USD=2
# 向量模型：DeepSeek 没有 embedding 模型，按 RD-Agent README 示例使用 SiliconFlow
EMBEDDING_MODEL=litellm_proxy/BAAI/bge-m3
LITELLM_PROXY_API_KEY=
LITELLM_PROXY_API_BASE=https://api.siliconflow.cn/v1

# ---- RD-Agent 回测容器（按本机内存调整）----
QLIB_DOCKER_MEM_LIMIT=8g
QLIB_DOCKER_SHM_SIZE=2g
QLIB_DOCKER_ENABLE_GPU=False

# ---- RD-Agent Web UI（rdagent-web）----
# 访问令牌，必填；生成方式：python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
UI_SERVER_AUTH_TOKEN=

# ---- Factopia Web 界面（web 服务）----
# 默认只允许本机访问。云服务器对外开放前须先加 HTTPS 与登录，再改为 0.0.0.0
FACTOPIA_WEB_BIND=127.0.0.1
FACTOPIA_WEB_PORT=18080
