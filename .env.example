# 复制为 .env 后填写；.env 不提交到 Git

# ---- 基础 ----
FACTOPIA_DATA_DIR=/workspace/runtime/data
FACTOPIA_QLIB_DIR=/workspace/runtime/qlib_data
MLFLOW_TRACKING_URI=http://mlflow:5000

# ---- LLM（RD-Agent 使用）----
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
# choose LLM: https://www.alibabacloud.com/help/zh/model-studio/models
# 对话模型：DeepSeek
# 方式一：阿里云百炼（OpenAI 兼容，当前使用）
CHAT_MODEL=openai/deepseek-v4.1-flash
OPENAI_API_KEY=
OPENAI_API_BASE=https://llm-tlndh47wd9ustbss.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
FACTOPIA_LLM_BASE_URL=https://llm-tlndh47wd9ustbss.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 复杂任务：研究规格起草、Agent 诊断/规划、公告标注、AI 解释等
# 百炼工作空间需先授权该模型；当前用于本项目的授权模型为 qwen3.8-max-0902
FACTOPIA_LLM_MODEL=qwen3.8-max-0902
# 简单任务：语义检索改写、自动回流线索改写、术语表候选等；留空则回退到大模型
# 当前使用 deepseek-v4.1-flash（已授权）
FACTOPIA_LLM_LITE_MODEL=deepseek-v4.1-flash
# 深度思考的独立 Critic 模型（Planner 仍用 FACTOPIA_LLM_MODEL）；留空或 403 时回退主模型
FACTOPIA_LLM_CRITIC_MODEL=qwen-plus
FACTOPIA_LLM_API_KEY=
FACTOPIA_LLM_EXTRA_BODY={"enable_thinking": false}
# ---- 联网搜索（可选：研究立项页「外部资料检索」）----
# provider: bailian（百炼内置搜索，使用 FACTOPIA_LLM_API_KEY）/ bocha / tavily
FACTOPIA_SEARCH_PROVIDER=bailian
FACTOPIA_SEARCH_MODEL=qwen-plus
# 仅 bocha / tavily 需要；bailian 复用 FACTOPIA_LLM_API_KEY
#FACTOPIA_SEARCH_API_KEY=
# 只采用该日期之前发表的资料（研究测试期从 2022 年开始）
FACTOPIA_SEARCH_BEFORE=2021-12-31
#FACTOPIA_SEARCH_BASE_URL=  # 仅 bocha/tavily 需要；bailian 用 FACTOPIA_LLM_BASE_URL
#FACTOPIA_SEARCH_COUNT=8
#FACTOPIA_SEARCH_ALLOW_UNKNOWN=false
# 方式二：DeepSeek 官方（取消注释，并删除方式一）
#CHAT_MODEL=deepseek/deepseek-chat
#DEEPSEEK_API_KEY=
# 费用：单价（美元 / 百万 token，按服务商价目表填写）；RD-Agent 统计不到思考 token，输出按系数放大估算
FACTOPIA_LLM_PRICE_IN=0.27
FACTOPIA_LLM_PRICE_OUT=1.10
FACTOPIA_LLM_REASONING_FACTOR=3
# 公告标注每次运行的花费上限（美元）
FACTOPIA_TEXT_BUDGET_USD=2
# 向量模型：DeepSeek 没有 embedding 模型，按 RD-Agent README 示例使用 SiliconFlow
# 向量模型：使用百炼的 text-embedding-v4（与对话模型同一端点与密钥）
EMBEDDING_MODEL=openai/text-embedding-v4
LITELLM_PROXY_API_KEY=
# LITELLM_PROXY_API_BASE=https://api.siliconflow.cn/v1
LITELLM_PROXY_API_BASE=https://llm-tlndh47wd9ustbss.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ---- RD-Agent 回测容器（按本机内存调整）----
QLIB_DOCKER_MEM_LIMIT=8g
QLIB_DOCKER_SHM_SIZE=2g
QLIB_DOCKER_ENABLE_GPU=False

# ---- RD-Agent Web UI（rdagent-web）----
# 访问令牌，必填；生成方式：python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
UI_SERVER_AUTH_TOKEN=

# ---- Factopia Web 界面（web 服务）----
# 默认只允许本机访问。云服务器对外开放前须先加 HTTPS 与登录，再改为 0.0.0.0
FACTOPIA_WEB_BIND=127.0.0.1
FACTOPIA_WEB_PORT=18080

# ---- 模拟盘（factopia.paper）----
# 影子撮合模式的初始资金（默认 1000000，可用 base_currency 口径）
FACTOPIA_PAPER_CAPITAL=1000000
# 每日自动推进行情时刻（UTC 时，默认 19 = 北京 03:00）：runner 后台执行 download → standardize
FACTOPIA_DATA_UPDATE_UTC_HOUR=19
# 模拟盘每日自动推进时刻（UTC 时，默认 9）：须晚于数据更新时刻，避免用到旧行情
FACTOPIA_PAPER_ADVANCE_UTC_HOUR=9
# 长桥 LongPort 通道（可选）：三个变量全非空才启用，且只支持港股。
# 在长桥开发者中心开通模拟账户后获取；接入中途不要改动（模式在接入时固化到 enrolled.json）
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=
